# Copy to .env and set your model service details. .env is not committed.
# Load with: uv run --env-file .env atestservice
COMAGIC_BASE_URL=https://your-model-service.example/v1
COMAGIC_API_KEY=replace-with-your-api-key
COMAGIC_MODEL=your-model-name
# Optional header required by some company model services.
COMAGIC_EMPLOYEE_NO=
